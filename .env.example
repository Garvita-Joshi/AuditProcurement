# Local development configuration. Copy this file to .env, then replace the
# example password before starting the application.

# Docker PostgreSQL connection used by FastAPI and SQLAlchemy.
POSTGRES_DB=auditai
POSTGRES_USER=auditai_user
POSTGRES_PASSWORD=replace_with_a_local_development_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://auditai_user:replace_with_a_local_development_password@localhost:5433/auditai

# Optional: enables Gemini-powered receipt extraction and audit reports.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Separate company mailbox for supplier quotation requests. Never reuse OTP mail settings.
SOURCING_SMTP_HOST=
SOURCING_SMTP_PORT=587
SOURCING_SMTP_USERNAME=
SOURCING_SMTP_PASSWORD=
SOURCING_MAIL_FROM=prepares23@gmail.com
SOURCING_SMTP_SSL=false
# Supplier replies are fetched through IMAP, which is independent of SMTP.
# Gmail and Outlook hosts can be inferred from the SMTP host; other providers
# must set their actual mailbox IMAP host here.
SOURCING_IMAP_HOST=
SOURCING_IMAP_PORT=993
SOURCING_IMAP_USERNAME=
SOURCING_IMAP_PASSWORD=
SOURCING_IMAP_SSL=true

# Optional procurement model bundle. Defaults to backend/trained_models/procurement_bundle.joblib
# PROCUREMENT_MODEL_BUNDLE=/absolute/path/to/procurement_bundle.joblib

# Sandbox only. The approved recipient must equal this merchant ID.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
